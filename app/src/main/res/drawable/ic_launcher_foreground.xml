<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Neon Holographic Soundwave / Disc / Diamond Center -->
    <!-- Outer Cyber Hexagon / Octagon -->
    <path
        android:pathData="M54,26 L76,38 L76,70 L54,82 L32,70 L32,38 Z"
        android:strokeWidth="2.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="26"
                android:endX="76"
                android:endY="82"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#7A5CFF" android:offset="0.6" />
                <item android:color="#FF007A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Play / Audio Pulse Core -->
    <path
        android:pathData="M49,43 L65,54 L49,65 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="49"
                android:startY="43"
                android:endX="65"
                android:endY="65"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon Equalizer Frequency Bars -->
    <path
        android:pathData="M38,48 L38,60"
        android:strokeColor="#00F0FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M70,48 L70,60"
        android:strokeColor="#7A5CFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

</vector>
